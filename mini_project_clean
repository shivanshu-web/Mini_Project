alue_counts()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"lp","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# 1. Clean the strings by removing decimals like \".0\" (e.g., \"512.0 GB\" -> \"512GB\")\n# and stripping the \"GB\" and \"TB\" characters\nlp['Memory'] = lp['Memory'].astype(str).replace('.0', '', regex=True)\nlp['Memory'] = lp['Memory'].str.replace('GB', '')\nlp['Memory'] = lp['Memory'].str.replace('TB', '000') # Convert 1TB to 1000GB safely\n\n# 2. Split the memory configurations on the \"+\" sign (for dual storage laptops)\n# e.g., \"128 SSD + 1000 HDD\" becomes two parts: \"128 SSD\" and \"1000 HDD\"\nmemory_split = lp['Memory'].str.split(\"+\", n=1, expand=True)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"memory_split.sample(30)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Clean up whitespace on the split parts\nlp['first'] = memory_split[0].str.strip()\nlp['second'] = memory_split[1].str.strip()\nlp['second'].fillna(\"0\", inplace=True) # Fill missing second drive with \"0\"\n# 3. Create helper binary flag columns to locate storage types in the 'first' part\nlp['Layer1SSD'] = lp['first'].apply(lambda x: 1 if \"SSD\" in x else 0)\nlp['Layer1HDD'] = lp['first'].apply(lambda x: 1 if \"HDD\" in x else 0)\nlp['Layer1Flash'] = lp['first'].apply(lambda x: 1 if \"Flash\" in x else 0)\nlp['Layer1Hybrid'] = lp['first'].apply(lambda x: 1 if \"Hybrid\" in x else 0)\n# Extract only the digits from the 'first' part\nlp['first'] = lp['first'].str.extract(r'(\\d+)').astype(float).fillna(0).astype(int)\n# 4. Create helper binary flag columns to locate storage types in the 'second' part\nlp['Layer2SSD'] = lp['second'].apply(lambda x: 1 if \"SSD\" in x else 0)\nlp['Layer2HDD'] = lp['second'].apply(lambda x: 1 if \"HDD\" in x else 0)\nlp['Layer2Flash'] = lp['second'].ap